# ForexWizard AI Market Brain — backend environment template
# Copy this file to .env and adjust as needed.
# All values below are the in-code defaults; .env values override defaults,
# and real OS environment variables override .env values.

APP_NAME="ForexWizard AI Market Brain API"
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# No-auth current XAU spot source. Do not put a key here.
GOLD_API_BASE_URL=https://api.gold-api.com
GOLD_API_SYMBOL=XAU
QUOTE_REFRESH_SECONDS=30
STALE_AFTER_SECONDS=90

# Zero-setup default. PostgreSQL can replace this URL in production.
DATABASE_URL=sqlite:///./forexwizard.db
REDIS_URL=redis://localhost:6379/0

# OPTIONAL: bootstrap historical candles. Leave empty for sampled-only mode.
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOL=XAU/USD

# No-key GDELT research metadata collector.
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
RESEARCH_QUERY=(gold OR XAUUSD OR "Federal Reserve" OR "real yields")
RESEARCH_REFRESH_SECONDS=900
RESEARCH_TIMESPAN=24h
RESEARCH_MAX_RECORDS=30

# Conservative analysis threshold.
ANALYSIS_MIN_CANDLES=14
PREDICTION_INTERVAL_SECONDS=60
