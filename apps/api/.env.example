# ForexWizard AI Market Brain — backend environment template
# Copy this file to .env and adjust as needed.
# All values below are the in-code defaults; .env values override defaults,
# and real OS environment variables override .env values.

# Phase 5.4: production CORS — comma-separated list of allowed frontend origins.
# If set, takes priority over FRONTEND_ORIGIN for CORS middleware.
# Example: CORS_ORIGINS=https://forexwizard.example.com,https://www.forexwizard.example.com
CORS_ORIGINS=

APP_NAME="ForexWizard AI Market Brain API"
ENVIRONMENT=development
FRONTEND_ORIGIN=http://localhost:3000

# No-auth current XAU spot source. Do not put a key here.
GOLD_API_BASE_URL=https://api.gold-api.com
GOLD_API_SYMBOL=XAU
QUOTE_REFRESH_SECONDS=30
STALE_AFTER_SECONDS=90

# Zero-setup default. SQLite works for development with WAL mode enabled.
# PostgreSQL is RECOMMENDED for production (supports concurrent reads during builds).
#   QUICK LOCAL MODE (dev):      DATABASE_URL=sqlite:///./forexwizard.db
#   RECOMMENDED BRAIN MODE:      DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/forexwizard
DATABASE_URL=sqlite:///./forexwizard.db
REDIS_URL=redis://localhost:6379/0

# OPTIONAL: bootstrap historical candles. Leave empty for sampled-only mode.
TWELVE_DATA_API_KEY=
TWELVE_DATA_SYMBOL=XAU/USD

# No-key GDELT research metadata collector.
GDELT_BASE_URL=https://api.gdeltproject.org/api/v2/doc/doc
RESEARCH_QUERY=(gold OR XAUUSD OR "Federal Reserve" OR "real yields")
RESEARCH_REFRESH_SECONDS=900
RESEARCH_TIMESPAN=24h
RESEARCH_MAX_RECORDS=30

# Conservative analysis threshold.
ANALYSIS_MIN_CANDLES=14
PREDICTION_INTERVAL_SECONDS=60

# Phase 3: Historical market-memory layer.
HISTORICAL_SYMBOL=XAU/USD
HISTORICAL_SYNC_ENABLED=true
HISTORICAL_SYNC_MAX_RETRIES=3
HISTORICAL_FEATURES_ENABLED=true

# Phase 5.6: Trade Plan Engine — XAU/USD broker contract spec.
# OPTIONAL: configure to enable position-sizing calculations.
# All three must be set; if any is missing the API returns
# POSITION_SIZE_UNAVAILABLE rather than guessing.
# Common defaults for standard XAU/USD:
#   contract_size = 100 (oz per 1.0 lot)
#   tick_size     = 0.01 (smallest price increment)
#   tick_value    = 1.0  (USD per tick per 1.0 lot)
XAUUSD_CONTRACT_SIZE=
XAUUSD_TICK_SIZE=
XAUUSD_TICK_VALUE=
